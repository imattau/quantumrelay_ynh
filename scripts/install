#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_script_progression "Downloading the quantum-relay binary..."

ynh_setup_source --dest_dir="$install_dir"
chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R "$app:www-data" "$install_dir"
# ynh_setup_source (source id "main", format "whatever") saves the
# downloaded asset as $install_dir/main, not under its original release
# filename.
mv "$install_dir/main" "$install_dir/quantum-relay"
chmod +x "$install_dir/quantum-relay"

mkdir -p "$data_dir"
chown -R "$app:www-data" "$data_dir"

mkdir -p "/var/log/$app"
chown -R "$app:www-data" "/var/log/$app"

#=================================================
# ADD A CONFIGURATION
#=================================================

ynh_script_progression "Adding configuration..."

require_auth_yaml="false"
if [ "${require_auth:-0}" -eq 1 ]; then
	require_auth_yaml="true"
fi

ynh_add_config --template="config.yaml" --destination="$install_dir/config.yaml"
chmod 640 "$install_dir/config.yaml"
chown "$app:www-data" "$install_dir/config.yaml"

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Configuring the systemd service and nginx..."

yunohost service add "$app" --description="Nostr relay with quantum walk propagation" --log="/var/log/$app/$app.log"

ynh_add_systemd_config

ynh_add_nginx_config

# Public peer-mesh TLS listener (own port, own server block).
ynh_app_peer_nginx_config

ynh_exec_warn_less yunohost firewall allow --no-upnp TCP "$public_peer_port"

#=================================================
# START SYSTEMD SERVICE
#=================================================

ynh_script_progression "Starting quantum-relay..."

ynh_systemd_action --service_name="$app" --action="start" --log_path="/var/log/$app/$app.log" --line_match="listening"

ynh_script_progression "Installation complete"
